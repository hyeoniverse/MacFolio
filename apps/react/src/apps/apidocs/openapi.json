	"info": {
		"title": "MacFolio API",
		"description": "메시지(피드백), 블로그(관리자 편집), 메일",
		"version": "0.1.0",
		"contact": {}
	},
	"tags": [],
	"servers": [],
	"components": {
		"securitySchemes": {
			"cookie": {
				"type": "apiKey",
				"in": "cookie",
				"name": "macfolio_session"
			}
		},
		"schemas": {
			"HealthResponse": {
				"type": "object",
				"properties": {
					"status": {
						"type": "string",
						"example": "ok"
					},
					"database": {
						"type": "string",
						"example": "up",
						"description": "DB에 쿼리가 되는지"
					},
					"version": {
						"type": "string",
						"example": "sha-1a2b3c4",
						"description": "배포한 커밋 (자동 배포가 새 버전이 떴는지 확인한다). 로컬은 dev"
					}
				},
				"required": [
					"status",
					"database",
					"version"
				]
			},
			"AdminResponse": {
				"type": "object",
				"properties": {
					"login": {
						"type": "string",
						"example": "hyeoniverse"
					},
					"signedInAt": {
						"type": "string",
						"example": "2026-10-02T10:03:00.000Z",
						"description": "이 세션으로 로그인한 때 (ISO 8601)"
					},
					"expiresAt": {
						"type": "string",
						"example": "2026-10-02T22:03:00.000Z",
						"description": "이 세션이 끝나는 때 (ISO 8601)"
					}
				},
				"required": [
					"login",
					"signedInAt",
					"expiresAt"
				]
			}
		}
	}
}
