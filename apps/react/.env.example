# 모두 선택 사항입니다. 비워 두면 public/ 폴더의 /imgs, /musics, /sounds를 씁니다.
VITE_APP_IMAGE_URL=
VITE_APP_MUSIC_URL=
VITE_APP_SFX_URL=

# MacFolio API (apps/api). 있으면 관리자 로그인을 켠다. 로컬: http://localhost:4000
VITE_API_URL=

# 메시지 앱의 저장소.
#   local: 이 브라우저(localStorage)에만 저장한다. 서버 없이 화면을 확인할 때 (개발용)
#   비우거나 server: 서버(VITE_API_URL)에 저장한다. 서버에 닿지 못하면 메시지 앱을 열지 않고 알린다 (배포 기본값)
VITE_MESSAGES_STORE=
