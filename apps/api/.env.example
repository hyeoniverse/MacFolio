# 복사해서 .env로 쓴다 (.env는 커밋하지 않는다)

# 서버 포트 (3000은 Next.js 같은 다른 개발 서버와 자주 겹쳐서 4000)
PORT=4000

# docker compose의 db와 같은 값 (docker-compose.yml)
DATABASE_URL=postgresql://macfolio:macfolio@localhost:5432/macfolio

# 요청을 허용할 프론트엔드 주소 (쉼표로 여러 개). 배포에서는 https://macfolio.hyeoniverse.com
CORS_ORIGINS=http://localhost:5173

# ─── 관리자 로그인 (다음 단계에서 쓴다) ───
# GitHub OAuth App (개발용 콜백: http://localhost:4000/auth/github/callback)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
