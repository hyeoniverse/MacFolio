# 로컬 개발용. 복사해서 .env로 쓴다 (.env는 커밋하지 않는다)
# 로컬 API는 .env만 읽는다. 배포 서버는 서버의 ~/deploy/api.env를 쓴다 (docs/deployment.md).
# 배포용 값(CORS_ORIGINS=https://macfolio.hyeoniverse.com, 배포용 OAuth 앱 등)을 내 컴퓨터에 적어 두려면
# .env가 아니라 .env.production에 둔다. 커밋되지 않고(.gitignore의 .env.*), API도 읽지 않는다.
# .env에 배포용 CORS_ORIGINS가 들어가면 로컬 사이트가 서버에 연결하지 못한다 (API가 뜰 때 경고한다).

# 서버 포트 (3000은 Next.js 같은 다른 개발 서버와 자주 겹쳐서 4000)
PORT=4000

# docker compose의 db와 같은 값 (docker-compose.yml)
DATABASE_URL=postgresql://macfolio:macfolio@localhost:5432/macfolio

# 요청을 허용할 프론트엔드 주소 (쉼표로 여러 개). 배포에서는 https://macfolio.hyeoniverse.com
# *는 점 없는 이름 한 칸(영소문자·숫자·-)에 맞는다. PR 미리보기: https://*-macfolio.hyeoniverse.workers.dev
CORS_ORIGINS=http://localhost:5173

# ─── 관리자 로그인 (GitHub OAuth) ───
# GitHub OAuth App의 값. 비워 두면 로그인만 막히고 나머지 API는 동작한다
# 개발용 콜백 주소: http://localhost:4000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 관리자로 인정할 GitHub 계정의 숫자 ID (기본 68999618 = hyeoniverse). 확인: gh api users/<이름> --jq .id
# 이름은 바꿀 수 있고 옛 이름을 남이 가져갈 수 있어서, 바뀌지 않는 ID로 비교한다
# ADMIN_GITHUB_ID=68999618
# 로그인 요청을 IP마다 1분에 몇 번까지 받을지 (기본 10)
# AUTH_RATE_LIMIT=10
# 앞에 둔 프록시 수 (배포에서 nginx·Cloudflare 뒤라면 1 이상). 0이면 X-Forwarded-For를 믿지 않는다
# TRUST_PROXY=0
# 이 API의 바깥 주소 (OAuth 콜백 주소를 만든다). 배포: https://macfolio-api.hyeoniverse.com
# API_URL=http://localhost:4000
# 로그인 후 돌아갈 프론트엔드 (기본: CORS_ORIGINS의 첫 주소)
# FRONTEND_URL=http://localhost:5173

# ─── 댓글 ───
# IP를 그대로 저장하지 않고 이 키로 HMAC한다. 배포에서는 긴 무작위 값을 꼭 넣는다 (openssl rand -hex 32)
# IP_HASH_SECRET=
# 댓글 쓰기·지우기를 IP마다 1분에 몇 번까지 받을지 (기본 5)
# COMMENT_RATE_LIMIT=5

# ─── 글에 넣을 사진 찾기 (관리자 편집기) ───
# 비워 두면 그 서비스만 꺼진다. 키는 서버에만 두고 화면에는 내보내지 않는다
# Unsplash: https://unsplash.com/oauth/applications 에서 앱을 만들고 Access Key
# UNSPLASH_ACCESS_KEY=
# Pexels: https://www.pexels.com/api/ 에서 받은 API 키
# PEXELS_API_KEY=

# ─── GitHub 앱 (프로필·README·저장소) ───
# 비워 두어도 된다. 없으면 GitHub API를 이 서버 IP로 시간당 60번까지만 부를 수 있어서 받은 값을 30분 동안 들고 있는다.
# 넣으면 시간당 5,000번이라 10분마다 새로 받는다. 권한(scope)이 없는 토큰이면 충분하다 (공개 정보만 읽는다)
# https://github.com/settings/personal-access-tokens 에서 Public repositories (read-only)
# GITHUB_TOKEN=

# ─── 음성 만들기 데모 (Safari의 HYEONIVERSE 페이지) ───
# Fish → Google → Edge 차례로 만든다. 키가 없는 공급자는 건너뛰고, Edge는 키 없이 된다
# Fish Audio: https://fish.audio/app/api-keys
# FISH_AUDIO_API_KEY=
# Google Cloud Text-to-Speech API 키 (API 제한을 Text-to-Speech로 걸어 둔다)
# GOOGLE_TTS_API_KEY=
# 하루에 만들 수 있는 횟수: IP마다 (기본 3), 사이트 전체 (기본 50). 서버 메모리로 세어 다시 띄우면 처음부터 센다
# SPEECH_PER_IP_PER_DAY=3
# SPEECH_TOTAL_PER_DAY=50

# ─── 번역 · AI 요약 · AI 커버 데모 (Safari의 HYEONIVERSE 페이지) ───
# 키 이름은 HYEONIVERSE와 같아서 그 사이트의 키를 그대로 넣으면 된다. 키가 없는 공급자는 "키가 없습니다"로 건너뛴다
# 번역: DeepL → Google 차례. DeepL 무료 키(끝이 :fx)는 api-free 주소로 알아서 보낸다
# DEEPL_API_KEY=
# Google Cloud Translation API 키 (API 제한을 Cloud Translation으로 걸어 둔다)
# GOOGLE_TRANSLATE_API_KEY=
# 요약: Groq(기본) → Gemini 차례로 한국어·영어 요약을 함께 만든다
# Groq 키 (console.groq.com → API Keys). 모델은 기본 openai/gpt-oss-120b. Groq는 모델을 자주 내리니 내려가면 바꾼다
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Gemini는 Groq가 실패할 때. 모델은 기본 gemini-flash-latest (늘 최신 Flash. gemini-2.0-flash는 내려갔다)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# 커버: Cloudflare Workers AI → Hugging Face (둘 다 FLUX.1 schnell). 그림은 저장하지 않고 응답으로만 보낸다
# Cloudflare 계정 ID와, Workers AI 권한만 준 API 토큰 (매일 무료 할당이 다시 채워진다)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_TOKEN=
# HUGGINGFACE_API_KEY=
# 하루에 쓸 수 있는 횟수 (데모마다 따로 센다): IP마다 기본 3번, 사이트 전체 기본 50번 (커버는 IP마다 1번, 전체 5번)
# TRANSLATE_PER_IP_PER_DAY=3
# TRANSLATE_TOTAL_PER_DAY=50
# SUMMARY_PER_IP_PER_DAY=3
# SUMMARY_TOTAL_PER_DAY=50
# COVER_PER_IP_PER_DAY=1
# COVER_TOTAL_PER_DAY=5

# ─── 연락 메일 (메일 앱, #25) ───
# 셋이 다 있어야 서버가 보낸다. 없으면 사이트가 방문자의 메일 앱을 연다 (mailto)
# Resend API 키 (resend.com → API Keys, Sending access). 무료: 월 3,000통, 하루 100통
# RESEND_API_KEY=
# 받는 사람 (사이트 주인)
# CONTACT_TO=hyeoniverse.dev@gmail.com
# 보내는 주소: Resend에서 인증한 도메인의 주소. 보낸 사람의 주소는 Reply-To로 들어간다
# CONTACT_FROM=MacFolio <contact@hyeoniverse.com>
# 사람 확인 (Cloudflare Turnstile, 무료). 비우면 확인하지 않는다. 사이트 키는 공개 값이라 사이트가 /contact에서 받아 간다
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# 하루 상한 (기본 IP마다 5통, 사이트 전체 50통)
# CONTACT_PER_IP_PER_DAY=5
# CONTACT_TOTAL_PER_DAY=50
