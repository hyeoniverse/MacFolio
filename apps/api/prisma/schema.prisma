// MacFolio API 데이터 모델. 모델은 기능을 붙일 때마다 더한다 (#9: 관리자, 게시물·폴더, 피드백).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// 관리자 로그인 세션. 쿠키에는 무작위 토큰을, DB에는 그 해시만 둔다 (DB가 새어도 세션을 가로챌 수 없다)
model AdminSession {
  id          String   @id @default(cuid())
  /// 토큰의 SHA-256 (hex)
  tokenHash   String   @unique
  /// GitHub 숫자 ID (바뀌지 않는다). 관리자 확인은 이 값으로 한다
  githubId    Int
  /// 로그인할 때의 계정 이름 (보여 주기용)
  githubLogin String
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

/// 메모(블로그) 정리 내용: 만든 폴더, 옮긴 글·폴더, 고정. 글은 저장소의 Markdown 파일이고, 이 정리 내용을 겹쳐 보여 준다.
/// 한 행만 쓴다 (id = 1). 관리자만 바꾼다
model MemoOrganization {
  id        Int      @id @default(1)
  /// { folders, posts, moves, pins } (apps/react/src/apps/memo/organize.ts의 Organization)
  data      Json
  updatedAt DateTime @updatedAt
  /// 마지막으로 바꾼 관리자 (GitHub 계정 이름)
  updatedBy String
}

/// 블로그 글의 댓글. 방문자는 이름·비밀번호로 쓰고 같은 비밀번호로 지운다. 관리자는 김정현으로 쓰고 무엇이든 지운다
model PostComment {
  id           String   @id @default(cuid())
  /// 글 주소 (Markdown 파일 이름)
  postSlug     String
  name         String
  body         String
  /// 관리자가 쓴 댓글 (이름은 김정현, 비밀번호 없음)
  isAdmin      Boolean  @default(false)
  /// 비밀번호의 scrypt 해시 (관리자 댓글은 없음)
  passwordHash String?
  /// 화면에 보이는 IP 앞 두 자리 (예: 211.234). 원문은 저장하지 않는다
  ipPrefix     String?
  /// IP를 비밀 키로 HMAC한 값 (같은 사람이 쓴 댓글을 묶어 볼 때만)
  ipHash       String
  createdAt    DateTime @default(now())

  @@index([postSlug, createdAt])
}

/// 관리자가 쓰거나 고친 블로그 글. 저장소의 Markdown 글과 주소(slug)가 같으면 이 글이 그 글을 대신한다.
/// 게시한 내용과 임시 저장(게시하지 않은 편집)을 따로 둔다. 방문자는 게시한 내용만, 그것도 날짜가 되어야 본다(예약 발행).
/// Markdown 글을 지우면 deleted로 남겨 둔다 (파일은 그대로 있어서, 표시가 없으면 다시 보인다).
/// 지운 글은 30일 동안 '최근 삭제된 항목'에서 되살릴 수 있다 (deletedAt)
model Post {
  slug           String         @id
  /// 게시한 내용. 모두 null이면 서버에서 게시한 적 없음 (저장소 글이 그대로 보이거나, 새 글이면 아무에게도 안 보인다)
  title          String?
  /// YYYY-MM-DD. 오늘보다 뒤면 그날까지 방문자에게 보이지 않는다 (예약 발행)
  date           String?
  /// 폴더 경로 (예: 개발기/MacFolio)
  category       String?
  summary        String?
  /// Markdown 본문
  body           String?
  publishedAt    DateTime?
  /// 임시 저장. 모두 null이면 게시한 그대로
  draftTitle     String?
  draftDate      String?
  draftCategory  String?
  draftSummary   String?
  draftBody      String?
  draftUpdatedAt DateTime?
  deleted        Boolean        @default(false)
  /// 지운 때. 있으면 '최근 삭제된 항목'에 30일 동안 남아 되살릴 수 있다. 없는데 deleted면 영구히 지운 것 (저장소 글을 가리는 표시만 남는다)
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  /// 마지막으로 바꾼 관리자 (GitHub 계정 이름)
  updatedBy      String
  revisions      PostRevision[]
}

/// 게시할 때마다 남기는 버전 (글마다 최근 50개). 되돌리면 그 내용이 임시 저장으로 들어간다
model PostRevision {
  id        Int      @id @default(autoincrement())
  postSlug  String
  post      Post     @relation(fields: [postSlug], references: [slug], onDelete: Cascade)
  title     String
  date      String
  category  String
  summary   String
  body      String
  createdAt DateTime @default(now())
  createdBy String

  @@index([postSlug, createdAt])
}

/// 글에 넣은 이미지와 첨부 파일. 배포 환경마다 디스크가 다를 수 있어서 DB에 바로 둔다 (한 파일 10MB까지)
model Upload {
  /// 무작위 (주소를 짐작할 수 없게)
  id        String   @id
  /// 올린 파일 이름 (내려받을 때 이 이름으로)
  name      String
  /// MIME 형식. 이미지(PNG·JPEG·GIF·WebP)는 파일 앞부분으로 확인한 값
  type      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
  /// 올린 관리자 (GitHub 계정 이름)
  createdBy String
}
