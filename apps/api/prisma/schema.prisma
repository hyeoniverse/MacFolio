// MacFolio API 데이터 모델. 모델은 기능을 붙일 때마다 더한다 (#9: 관리자, 게시물·폴더, 피드백).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// 관리자 로그인 세션. 쿠키에는 무작위 토큰을, DB에는 그 해시만 둔다 (DB가 새어도 세션을 가로챌 수 없다)
model AdminSession {
  id          String   @id @default(cuid())
  /// 토큰의 SHA-256 (hex)
  tokenHash   String   @unique
  /// GitHub 숫자 ID (바뀌지 않는다). 관리자 확인은 이 값으로 한다
  githubId    Int
  /// 로그인할 때의 계정 이름 (보여 주기용)
  githubLogin String
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

/// 메모(블로그) 정리 내용: 만든 폴더, 옮긴 글·폴더, 고정. 글은 저장소의 Markdown 파일이고, 이 정리 내용을 겹쳐 보여 준다.
/// 한 행만 쓴다 (id = 1). 관리자만 바꾼다
model MemoOrganization {
  id        Int      @id @default(1)
  /// { folders, posts, moves, pins } (apps/react/src/apps/memo/organize.ts의 Organization)
  data      Json
  updatedAt DateTime @updatedAt
  /// 마지막으로 바꾼 관리자 (GitHub 계정 이름)
  updatedBy String
}

/// 블로그 글의 댓글. 방문자는 이름·비밀번호로 쓰고 같은 비밀번호로 지운다. 관리자는 김정현으로 쓰고 무엇이든 지운다
model PostComment {
  id           String   @id @default(cuid())
  /// 글 주소 (Markdown 파일 이름)
  postSlug     String
  name         String
  body         String
  /// 관리자가 쓴 댓글 (이름은 김정현, 비밀번호 없음)
  isAdmin      Boolean  @default(false)
  /// 비밀번호의 scrypt 해시 (관리자 댓글은 없음)
  passwordHash String?
  /// 화면에 보이는 IP 앞 두 자리 (예: 211.234). 원문은 저장하지 않는다
  ipPrefix     String?
  /// IP를 비밀 키로 HMAC한 값 (같은 사람이 쓴 댓글을 묶어 볼 때만)
  ipHash       String
  createdAt    DateTime @default(now())

  @@index([postSlug, createdAt])
}
