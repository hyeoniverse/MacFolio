// MacFolio API 데이터 모델. 모델은 기능을 붙일 때마다 더한다 (#9: 관리자, 게시물·폴더, 피드백).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// 관리자 로그인 세션. 쿠키에는 무작위 토큰을, DB에는 그 해시만 둔다 (DB가 새어도 세션을 가로챌 수 없다)
model AdminSession {
  id          String   @id @default(cuid())
  /// 토큰의 SHA-256 (hex)
  tokenHash   String   @unique
  /// GitHub 숫자 ID (바뀌지 않는다). 관리자 확인은 이 값으로 한다
  githubId    Int
  /// 로그인할 때의 계정 이름 (보여 주기용)
  githubLogin String
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}
