// MacFolio API 데이터 모델. 모델은 기능을 붙일 때마다 더한다 (#9: 관리자, 게시물·폴더, 피드백).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// 관리자 로그인 세션. 쿠키에는 무작위 토큰을, DB에는 그 해시만 둔다 (DB가 새어도 세션을 가로챌 수 없다)
model AdminSession {
  id          String   @id @default(cuid())
  /// 토큰의 SHA-256 (hex)
  tokenHash   String   @unique
  /// GitHub 숫자 ID (바뀌지 않는다). 관리자 확인은 이 값으로 한다
  githubId    Int
  /// 로그인할 때의 계정 이름 (보여 주기용)
  githubLogin String
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

/// 메모(블로그) 정리 내용: 만든 폴더, 옮긴 글·폴더, 고정. 글은 저장소의 Markdown 파일이고, 이 정리 내용을 겹쳐 보여 준다.
/// 한 행만 쓴다 (id = 1). 관리자만 바꾼다
model MemoOrganization {
  id        Int      @id @default(1)
  /// { folders, posts, moves, pins } (packages/desktop-core/src/memo/rules.ts의 Organization, 서버와 화면이 함께 쓴다)
  data      Json
  updatedAt DateTime @updatedAt
  /// 마지막으로 바꾼 관리자 (GitHub 계정 이름)
  updatedBy String
}

/// 블로그 글의 댓글. 방문자는 쿠키로 정한 이름(예: 🦊 날쌘 여우)으로 쓰고, 같은 브라우저에서만 지운다.
/// 관리자는 김정현으로 쓰고 무엇이든 지운다
model PostComment {
  id           String   @id @default(cuid())
  /// 글 주소 (Markdown 파일 이름)
  postSlug     String
  name         String
  body         String
  /// 관리자가 쓴 댓글 (이름은 김정현)
  isAdmin      Boolean  @default(false)
  /// 쓴 브라우저의 방문자 토큰 HMAC (visitors/visitor.ts). 이름·비밀번호를 받던 때의 댓글은 없다 (관리자만 지운다)
  visitorHash  String?
  /// 예전 방식(이름·비밀번호)으로 쓴 댓글의 비밀번호 scrypt 해시. 새 댓글은 비워 둔다
  passwordHash String?
  /// 화면에 보이는 IP 앞 두 자리 (예: 211.234). 원문은 저장하지 않는다
  ipPrefix     String?
  /// IP를 비밀 키로 HMAC한 값 (같은 사람이 쓴 댓글을 묶어 볼 때만)
  ipHash       String
  createdAt    DateTime @default(now())

  @@index([postSlug, createdAt])
}

/// 관리자가 쓰거나 고친 블로그 글. 저장소의 Markdown 글과 주소(slug)가 같으면 이 글이 그 글을 대신한다.
/// 게시한 내용과 임시 저장(게시하지 않은 편집)을 따로 둔다. 방문자는 게시한 내용만, 그것도 날짜가 되어야 본다(예약 발행).
/// Markdown 글을 지우면 deleted로 남겨 둔다 (파일은 그대로 있어서, 표시가 없으면 다시 보인다).
/// 지운 글은 30일 동안 '최근 삭제된 항목'에서 되살릴 수 있다 (deletedAt)
model Post {
  slug           String         @id
  /// 게시한 내용. 모두 null이면 서버에서 게시한 적 없음 (저장소 글이 그대로 보이거나, 새 글이면 아무에게도 안 보인다)
  title          String?
  /// YYYY-MM-DD. 오늘보다 뒤면 그날까지 방문자에게 보이지 않는다 (예약 발행)
  date           String?
  /// 폴더 경로 (예: 개발기/MacFolio)
  category       String?
  summary        String?
  /// Markdown 본문
  body           String?
  publishedAt    DateTime?
  /// 임시 저장. 모두 null이면 게시한 그대로
  draftTitle     String?
  draftDate      String?
  draftCategory  String?
  draftSummary   String?
  draftBody      String?
  draftUpdatedAt DateTime?
  deleted        Boolean        @default(false)
  /// 지운 때. 있으면 '최근 삭제된 항목'에 30일 동안 남아 되살릴 수 있다. 없는데 deleted면 영구히 지운 것 (저장소 글을 가리는 표시만 남는다)
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  /// 마지막으로 바꾼 관리자 (GitHub 계정 이름)
  updatedBy      String
  revisions      PostRevision[]
}

/// 게시할 때마다 남기는 버전 (글마다 최근 50개). 되돌리면 그 내용이 임시 저장으로 들어간다
model PostRevision {
  id        Int      @id @default(autoincrement())
  postSlug  String
  post      Post     @relation(fields: [postSlug], references: [slug], onDelete: Cascade)
  title     String
  date      String
  category  String
  summary   String
  body      String
  createdAt DateTime @default(now())
  createdBy String

  @@index([postSlug, createdAt])
}

/// 글에 넣은 이미지와 첨부 파일. 배포 환경마다 디스크가 다를 수 있어서 DB에 바로 둔다 (한 파일 10MB까지)
model Upload {
  /// 무작위 (주소를 짐작할 수 없게)
  id        String   @id
  /// 올린 파일 이름 (내려받을 때 이 이름으로)
  name      String
  /// MIME 형식. 이미지(PNG·JPEG·GIF·WebP)는 파일 앞부분으로 확인한 값
  type      String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
  /// 올린 관리자 (GitHub 계정 이름)
  createdBy String

  /// 배경화면의 원본·썸네일이면 그 배경화면 (지울 때 함께 지운다)
  wallpaperImage Wallpaper? @relation("WallpaperImage")
  wallpaperThumb Wallpaper? @relation("WallpaperThumb")
}

/// 관리자가 올린 배경화면 (시스템 설정 → 배경화면). 기본 배경화면은 프론트엔드에 있고, 여기에는 더한 것만 둔다.
/// 데스크톱과 휴대폰 어디서나 고를 수 있다 (화면 비율이 다르면 가운데 기준으로 잘린다).
/// 이미지는 Upload에 두고 /files/:id로 내려준다. 화면 모드와 상관없이 한 장이다
model Wallpaper {
  /// 무작위 (Upload id와 같은 모양)
  id        String   @id
  /// 썸네일 아래에 보이는 이름
  name      String
  imageId   String   @unique
  image     Upload   @relation("WallpaperImage", fields: [imageId], references: [id])
  thumbId   String   @unique
  thumb     Upload   @relation("WallpaperThumb", fields: [thumbId], references: [id])
  createdAt DateTime @default(now())
  /// 올린 관리자 (GitHub 계정 이름)
  createdBy String

  @@index([createdAt])
}

/// 메시지 앱의 피드백 하나 (쓰기 단추로 남긴 것). 목록의 항목 하나가 된다.
/// 사이트 주인의 고정 안내는 여기 없다 (안내 글은 프론트엔드에 있고, 거기 단 답글은 GuestMessage.threadId가 비어 있다)
model MessageThread {
  id          String         @id @default(cuid())
  /// 남긴 사람 이름 (방문자 쿠키로 정한 이름, 관리자는 김정현)
  title       String
  /// 남긴 브라우저의 방문자 토큰 HMAC (내 피드백인지 가린다)
  visitorHash String
  createdAt   DateTime       @default(now())
  messages    GuestMessage[]
}

/// 메시지 앱의 말풍선 하나 (피드백 본문이나 답글)
model GuestMessage {
  id          String         @id @default(cuid())
  /// 어느 피드백의 글인지. 비어 있으면 사이트 주인 안내에 단 답글
  threadId    String?
  thread      MessageThread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  name        String
  body        String
  /// 관리자가 쓴 글 (이름은 김정현)
  isAdmin     Boolean        @default(false)
  visitorHash String
  /// 화면에 보이는 IP 앞 두 자리. 원문은 저장하지 않는다
  ipPrefix    String?
  /// IP를 비밀 키로 HMAC한 값 (도배를 막을 때만)
  ipHash      String
  createdAt   DateTime       @default(now())

  @@index([threadId, createdAt])
}

/// GitHub 앱의 Pinned에 보일 저장소 (시스템 설정 → GitHub). 한 행만 쓴다 (id = 1). 관리자만 바꾼다.
/// 저장소 정보(설명·별·언어)는 여기 두지 않고 GitHub에서 받는다. 행이 없으면 기본 목록(github/showcase.ts)을 쓴다
model GithubShowcase {
  id        Int      @id @default(1)
  /// "owner/이름" 목록 (보이는 순서)
  repos     Json
  updatedAt DateTime @updatedAt
  /// 마지막으로 바꾼 관리자 (GitHub 계정 이름)
  updatedBy String
}

/// 트래픽 분석 이벤트 (#102). 사이트가 sendBeacon으로 보낸다. 90일 뒤 지우고, 그 전에 날마다 DailyStat으로 모은다.
/// 원래 IP는 없다: 순방문자는 하루 해시로 세고, 관리자 화면용 가린 IP는 7일 뒤 지운다
model AnalyticsEvent {
  id          String   @id @default(cuid())
  /// visit(페이지를 열었다), app(앱 열기), item(글·프로젝트 보기), link(바깥 링크), leave(머문 시간)
  type        String
  createdAt   DateTime @default(now())
  /// 받은 날 (한국 시간, YYYY-MM-DD). 집계 단위
  day         String
  /// HMAC(날짜 + IP + User-Agent). 날이 바뀌면 달라져서 날을 넘겨 한 사람을 따라갈 수 없다
  dayHash     String
  /// 페이지를 열 때마다 브라우저가 새로 만드는 무작위 값 (한 방문의 이벤트를 묶는다)
  visitId     String
  app         String?
  /// 글 주소, 프로젝트 이름, 바깥 링크 주소
  item        String?
  /// 처음 연 주소 (visit)
  path        String?
  /// 들어온 곳의 호스트만 (예: github.com). 직접 들어왔으면 비운다
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  /// CF-IPCountry (예: KR)
  country     String?
  /// desktop, mobile (화면 폭)
  device      String?
  /// User-Agent를 줄인 종류 (Chrome, Safari…)
  browser     String?
  os          String?
  language    String?
  /// 머문 시간 (ms, leave)
  duration    Int?
  /// 마지막 자리를 가린 IP (203.0.113.x). 7일 뒤 지운다
  maskedIp    String?

  @@index([day])
  @@index([createdAt])
}

/// 날마다 모은 분석 숫자 (#102). 이벤트를 지운 뒤에도 계속 남는다. (날짜, 지표, 키)마다 한 행
model DailyStat {
  day    String
  /// visits, visitors, appOpens, durationSec, durationVisits, referrer, source, campaign, app, item, link, country, device, browser, os, language
  metric String
  /// 지표 안의 이름 (예: referrer의 github.com). 합계 지표는 빈 문자열
  key    String
  value  Int

  @@id([day, metric, key])
}

/// 사진 앱의 캡션 (#21). 사진은 프로젝트 정보에서 꺼내므로 원래 캡션은 코드에 있고, 관리자가 고친 것만 사진 주소로 덮는다
model PhotoCaption {
  /// 사진 주소 (사이트가 쓰는 그대로)
  src       String   @id
  caption   String
  updatedAt DateTime @updatedAt
  /// 마지막으로 바꾼 관리자 (GitHub 계정 이름)
  updatedBy String
}

/// 메일 앱으로 받은 연락 메일 (#25). 보낸 브라우저(방문자 쿠키의 HMAC)만 자기 메일을 보고, 관리자는 모두 보고 답장한다.
/// 1년이 지나면 지운다
model ContactMail {
  id          String         @id @default(cuid())
  /// 보낸 브라우저의 방문자 토큰 HMAC (visitors/visitor.ts). 이 값이 같은 요청에만 이 메일을 보여 준다
  visitorHash String
  name        String
  /// 답장받을 주소 (메일의 Reply-To, 관리자 답장의 받는 사람)
  email       String
  subject     String
  body        String
  createdAt   DateTime       @default(now())
  replies     ContactReply[]

  @@index([visitorHash, createdAt])
  @@index([createdAt])
}

/// 관리자가 메일 앱에서 쓴 답장. 방문자의 메일 주소로 보내고, 방문자의 보낸 편지함에서도 그 메일 아래에 보인다
model ContactReply {
  id        String      @id @default(cuid())
  mailId    String
  mail      ContactMail @relation(fields: [mailId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime    @default(now())

  @@index([mailId])
}

/// 서버 자원 사용률 (RESOURCE_MONITOR가 off가 아닐 때). 1분마다 하나, 14일 뒤 지운다.
/// Oracle Always Free의 유휴 회수 위험(7일)과 화면의 그래프에 쓴다. CPU·메모리는 VM 전체, 네트워크는 API 컨테이너의 것
model ResourceSample {
  id      Int      @id @default(autoincrement())
  at      DateTime @default(now())
  /// CPU 사용률 (%)
  cpu     Float
  /// 메모리 사용률 (%)
  memory  Float
  /// 네트워크 (받고 보낸 합, Mbps)
  network Float

  @@index([at])
}

/// 보낸 알림 메일 (같은 알림을 너무 자주 보내지 않게). 서버를 다시 띄워도 남는다
model ResourceAlert {
  /// 알림 종류 (reclaim: 유휴 회수 위험)
  kind   String   @id
  sentAt DateTime
  /// 보낸 내용 요약
  detail String
}
