{
	"name": "@macfolio/api",
	"private": true,
	"version": "0.1.0",
	"description": "MacFolio API: 메시지, 블로그(관리자 편집), 메일 (#9)",
	"type": "module",
	"scripts": {
		"dev": "prisma generate && prisma migrate deploy && nest start --watch",
		"build": "prisma generate && tsc -p tsconfig.build.json",
		"start": "node dist/main.js",
		"start:prod": "prisma migrate deploy && node dist/main.js",
		"typecheck": "prisma generate && tsc --noEmit",
		"lint": "eslint . --max-warnings 0",
		"test": "prisma generate && vitest run --project unit",
		"openapi": "prisma generate && vitest run --project unit src/openapi.test.ts --update",
		"test:e2e": "prisma generate && prisma migrate deploy && vitest run --project e2e",
		"db:up": "docker compose up -d db",
		"db:migrate": "prisma migrate dev"
	},
	"dependencies": {
		"@macfolio/contracts": "workspace:*",
		"@macfolio/desktop-core": "workspace:*",
		"@macfolio/og-card": "workspace:*",
		"@nestjs/common": "^12.2.0",
		"@nestjs/core": "^12.2.0",
		"@nestjs/platform-express": "^12.2.0",
		"@nestjs/swagger": "^12.0.3",
		"@nestjs/throttler": "^6.7.1",
		"@prisma/adapter-pg": "7.10.1",
		"@prisma/client": "7.10.1",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"cookie-parser": "^1.4.7",
		"helmet": "^8.3.0",
		"msedge-tts": "^2.1.0",
		"pg": "^8.23.1",
		"prisma": "7.10.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@nestjs/cli": "^12.0.10",
		"@nestjs/testing": "^12.2.0",
		"@swc/core": "^1.16.20",
		"@types/cookie-parser": "^1.4.10",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.2.1",
		"@typescript/native": "npm:typescript@~7.0.2",
		"eslint": "^10.13.0",
		"globals": "^17.13.0",
		"supertest": "^7.3.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.72.0",
		"unplugin-swc": "^2.0.0",
		"vitest": "^5.0.5"
	}
}
