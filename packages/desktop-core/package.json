{
	"name": "@macfolio/desktop-core",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"description": "프레임워크에 의존하지 않는 데스크톱 로직 (창 관리, 메모, 음악). React는 src를 바로 쓰고(source 조건), 서버(Node)는 빌드한 dist를 쓴다",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./memo": {
			"source": "./src/memo/index.ts",
			"types": "./dist/memo/index.d.ts",
			"default": "./dist/memo/index.js"
		},
		"./music": {
			"source": "./src/music/index.ts",
			"types": "./dist/music/index.d.ts",
			"default": "./dist/music/index.js"
		},
		"./site": {
			"source": "./src/site/index.ts",
			"types": "./dist/site/index.d.ts",
			"default": "./dist/site/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc",
		"lint": "eslint . --max-warnings 0",
		"test": "vitest run"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.12.0",
		"typescript": "~5.9",
		"typescript-eslint": "^8.71.1",
		"vitest": "^4.1.11"
	},
	"files": [
		"dist"
	]
}
