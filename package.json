{
	"name": "macfolio",
	"private": true,
	"packageManager": "pnpm@10.34.5",
	"scripts": {
		"dev": "turbo run dev --filter=@macfolio/react",
		"dev:api": "turbo run dev --filter=@macfolio/api",
		"dev:all": "turbo run dev --filter=@macfolio/react --filter=@macfolio/api",
		"build": "turbo run build",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"lint": "turbo run lint",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"prettier": "^3.9.9",
		"turbo": "^2.11.7",
		"wrangler": "^4.148.0"
	}
}
